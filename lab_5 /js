<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Ввід користувача</title>
</head>
<body>

    <h2>Анкета</h2>

    <input type="text" id="name" placeholder="Введіть ім'я">
    <input type="number" id="age" placeholder="Введіть вік">

    <button onclick="showInfo()">Показати</button>

    <p id="output"></p>

    <script>
        function showInfo() {
            let name = document.getElementById("name").value;
            let age = document.getElementById("age").value;

            if (name === "" || age === "") {
                document.getElementById("output").textContent = "Заповніть всі поля!";
            } else {
                document.getElementById("output").innerHTML =
                    "Привіт, <b>" + name + "</b>! Тобі " + age + " років.";
            }
        }
    </script>

</body>
</html>
